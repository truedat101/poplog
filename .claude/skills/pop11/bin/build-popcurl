#!/bin/sh
# build-popcurl — build the popcurl shim (once) and generate the Pop-11 loader.
# Output: ~/.cache/pop11-skill/popcurl.{dylib|so} + ~/.cache/pop11-skill/popcurl.p
# Usage:  build-popcurl        (then, in Pop-11:  load ~/.cache/pop11-skill/popcurl.p )
set -e
here="$(cd "$(dirname "$0")/.." && pwd)"
cache="${HOME}/.cache/pop11-skill"
mkdir -p "$cache"

case "$(uname -s)" in
    Darwin) lib="$cache/popcurl.dylib" ;;
    *)      lib="$cache/popcurl.so" ;;
esac

if [ ! -f "$lib" ] || [ "$here/lib/popcurl_shim.c" -nt "$lib" ]; then
    command -v cc >/dev/null 2>&1 || {
        echo "build-popcurl: no C compiler; use the curl-CLI fallback instead" >&2
        exit 2
    }
    cc -O2 -shared -fPIC -o "$lib" "$here/lib/popcurl_shim.c" -lcurl
    echo "built $lib"
else
    echo "up to date: $lib"
fi

cat > "$cache/popcurl.p" <<EOF
;;; popcurl.p — generated by build-popcurl. Load with: load '$cache/popcurl.p';
section;
exload popcurl ['$lib']
(language C)
    lconstant
        pc_get(url, outfile)                        :int,
        pc_post(url, body, ctype, outfile)          :int,
        pc_version()                                :exptr,
    ;
endexload;
define http_get(url, outfile);      exacc pc_get(url, outfile)      enddefine;
define http_post(url, body, ctype, outfile);
    exacc pc_post(url, body, ctype, outfile)
enddefine;
define curl_version_string();  exacc_ntstring(exacc pc_version())  enddefine;
endsection;
EOF
echo "loader:  $cache/popcurl.p"
