#!/bin/sh
# pop11run — one-shot Pop-11 script runner.
#   pop11run file.p          run a script and exit
#   pop11run -c 'code'       run a code string and exit
# Poplog tree resolved like popsession: $POPLOG_ROOT, then the config
# persisted by install.sh (~/.cache/pop11-skill/config.json), then $usepop.
set -e

root="$POPLOG_ROOT"
config="$HOME/.cache/pop11-skill/config.json"
if [ -z "$root" ] && [ -f "$config" ]; then
    root="$(sed -n 's/.*"root"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$config")"
fi
[ -n "$root" ] || root="$usepop"
[ -n "$root" ] || {
    echo "pop11run: no Poplog tree found (set POPLOG_ROOT or run install.sh)" >&2
    exit 2
}
basepop="$root/target/pop/basepop11"
[ -x "$basepop" ] || { echo "pop11run: $basepop not found" >&2; exit 2; }

if [ "$1" = "-c" ]; then
    tmp="$(mktemp "${TMPDIR:-/tmp}/pop11run.XXXXXX.p")"
    trap 'rm -f "$tmp"' EXIT
    printf '%s\n' "$2" > "$tmp"
    set -- "$tmp"
fi

exec "$root/poplog" "$basepop" "$@" ":sysexit();"
