#!/bin/sh
# build-popsqlite — build the sqlite shim (once) and generate the Pop-11 loader.
# Output: ~/.cache/pop11-skill/popsqlite.{dylib|so} + ~/.cache/pop11-skill/popsqlite.p
# Usage:  build-popsqlite     (then, in Pop-11:  load ~/.cache/pop11-skill/popsqlite.p )
set -e
here="$(cd "$(dirname "$0")/.." && pwd)"
cache="${HOME}/.cache/pop11-skill"
mkdir -p "$cache"

case "$(uname -s)" in
    Darwin) lib="$cache/popsqlite.dylib" ;;
    *)      lib="$cache/popsqlite.so" ;;
esac

if [ ! -f "$lib" ] || [ "$here/lib/popsqlite_shim.c" -nt "$lib" ]; then
    command -v cc >/dev/null 2>&1 || {
        echo "build-popsqlite: no C compiler; use the sqlite3-CLI bridge instead" >&2
        exit 2
    }
    cc -O2 -shared -fPIC -o "$lib" "$here/lib/popsqlite_shim.c" -lsqlite3 || {
        echo "build-popsqlite: compile failed — missing sqlite3.h/libsqlite3?" >&2
        echo "  (Debian/Ubuntu: apt install libsqlite3-dev; macOS: xcode CLT)" >&2
        exit 2
    }
    echo "built $lib"
else
    echo "up to date: $lib"
fi

cat > "$cache/popsqlite.p" <<EOF
;;; popsqlite.p — generated by build-popsqlite.
;;; Load with: load '$cache/popsqlite.p';
;;; Handles are small ints (0 = failure). NULL columns come back as false.
section;
exload popsqlite ['$lib']
(language C)
    lconstant
        psq_version()               :exptr,
        psq_errmsg(db)              :exptr,
        psq_open(path)              :int,
        psq_close(db)               :int,
        psq_exec(db, sql)           :int,
        psq_prepare(db, sql)        :int,
        psq_step(st)                :int,
        psq_reset(st)               :int,
        psq_finalize(st)            :int,
        psq_col_count(st)           :int,
        psq_col_name(st, i)         :exptr,
        psq_col_text(st, i)         :exptr,
        psq_col_is_null(st, i)      :int,
        psq_bind_text(st, i, v)     :int,
        psq_changes(db)             :int,
        psq_last_rowid(db)          :exptr,
    ;
endexload;

define sqlite_version();  exacc_ntstring(exacc psq_version())  enddefine;

define sqlite_error(db);  exacc_ntstring(exacc psq_errmsg(db))  enddefine;

define sqlite_open(path) -> db;
    exacc psq_open(path) -> db;
    if db == 0 then mishap(path, 1, 'sqlite: ' <> sqlite_error(0)) endif;
enddefine;

define sqlite_close(db);  erase(exacc psq_close(db));  enddefine;

define sqlite_exec(db, sql);
    if exacc psq_exec(db, sql) /== 0 then
        mishap(sql, 1, 'sqlite: ' <> sqlite_error(db))
    endif;
enddefine;

;;; prepare + bind a list of values (all bound as text; sqlite coerces
;;; per column affinity). Bindings are the injection-safe path for
;;; anything user-supplied: sql uses ? placeholders.
define lconstant prep_bound(db, sql, bindings) -> st;
    lvars i = 0, v;
    exacc psq_prepare(db, sql) -> st;
    if st == 0 then mishap(sql, 1, 'sqlite: ' <> sqlite_error(db)) endif;
    for v in bindings do
        i + 1 -> i;
        if exacc psq_bind_text(st, i, v sys_>< '') /== 0 then
            erase(exacc psq_finalize(st));
            mishap(v, 1, 'sqlite: bind failed: ' <> sqlite_error(db));
        endif;
    endfor;
enddefine;

;;; run sql, return all rows as a list of vectors of strings
;;; (SQL NULL -> false). sqlite_query(db, sql) for no bindings.
define sqlite_query_b(db, sql, bindings) -> rows;
    lvars st, rc, n, i;
    prep_bound(db, sql, bindings) -> st;
    exacc psq_col_count(st) -> n;
    [%  repeat
            exacc psq_step(st) -> rc;
            quitif(rc == 101);
            if rc /== 100 then
                erase(exacc psq_finalize(st));
                mishap(sql, 1, 'sqlite: ' <> sqlite_error(db));
            endif;
            {%  for i from 0 to n - 1 do
                    if exacc psq_col_is_null(st, i) == 1 then
                        false
                    else
                        exacc_ntstring(exacc psq_col_text(st, i))
                    endif
                endfor
            %}
        endrepeat
    %] -> rows;
    erase(exacc psq_finalize(st));
enddefine;

define sqlite_query(db, sql);  sqlite_query_b(db, sql, [])  enddefine;

;;; INSERT/UPDATE/DELETE with ? bindings (no result rows)
define sqlite_run_b(db, sql, bindings);
    lvars st, rc;
    prep_bound(db, sql, bindings) -> st;
    exacc psq_step(st) -> rc;
    erase(exacc psq_finalize(st));
    if rc /== 101 and rc /== 100 then
        mishap(sql, 1, 'sqlite: ' <> sqlite_error(db))
    endif;
enddefine;

define sqlite_changes(db);  exacc psq_changes(db)  enddefine;

define sqlite_last_rowid(db);
    strnumber(exacc_ntstring(exacc psq_last_rowid(db)))
enddefine;
endsection;
EOF
echo "loader:  $cache/popsqlite.p"
